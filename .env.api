# Modo integrado com o backend real (npm run dev:api): fincore-api em :8080.
# O Vite (porta 5180) encaminha /api para a API (proxy em vite.config.ts), então
# front e API ficam na MESMA origem — necessário para cookies de sessão e para o
# axios enviar o header X-XSRF-TOKEN.
VITE_DATA_SOURCE=api
VITE_AUTH_ADAPTER=rest
VITE_API_BASE_URL=http://localhost:5180/api/v1
