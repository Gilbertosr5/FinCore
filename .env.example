# -----------------------------------------------------------------------------
# FinCore — variáveis de ambiente (copie para .env.local e ajuste)
# Todas as variáveis expostas ao navegador usam o prefixo VITE_.
# NUNCA coloque segredos aqui: tudo com prefixo VITE_ vai para o bundle público.
# -----------------------------------------------------------------------------

# Nome exibido na interface
VITE_APP_NAME=FinCore

# Fonte de dados dos repositórios:
#   mock -> persistência local de demonstração (IndexedDB), sem backend
#   api  -> API REST (backend Java + Spring Boot, ainda não disponível)
VITE_DATA_SOURCE=mock

# Adaptador de autenticação:
#   dev  -> adaptador de desenvolvimento (somente ambiente local, NÃO é autenticação real)
#   rest -> adaptador REST (sessão via cookie HttpOnly definida pelo backend)
VITE_AUTH_ADAPTER=dev

# URL base da API REST (usada quando VITE_DATA_SOURCE=api ou VITE_AUTH_ADAPTER=rest)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Timeout das requisições HTTP em milissegundos
VITE_API_TIMEOUT_MS=15000

# Fuso horário padrão (IANA)
VITE_DEFAULT_TIMEZONE=America/Sao_Paulo
